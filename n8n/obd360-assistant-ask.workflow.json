        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ role: 'user', parts: [{ text: $json.body.prompt }] }], systemInstruction: { parts: [{ text: 'შენ ხარ OBD360-ის ავტომობილის დიაგნოსტიკის ასისტენტი. უპასუხე ქართულად, მარტივი და გასაგები ენით. დაეყრდენი მხოლოდ მოწოდებულ სკანირების მონაცემებს და არ მოიგონო ფაქტები. გაითვალისწინე საუბრის ისტორია და უპასუხე მხოლოდ ახალ კითხვას. უსაფრთხოების საკითხებზე ურჩიე კვალიფიციურ ხელოსანს.' }] }, generationConfig: { temperature: 0.4, maxOutputTokens: 4096 } }) }}",
        "options": {
          "timeout": 25000
        }
      },
      "id": "70d284f6-b17a-4395-e487-d2f630219fa8",
      "name": "Call Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,

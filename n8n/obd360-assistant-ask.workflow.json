      "waitBetweenTries": 1500,
      "position": [0, 0],
      "credentials": {
        "googlePalmApi": {
          "id": "iwSPt1CB1Zhao2Q5",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { text: $json.candidates?.[0]?.content?.parts?.[0]?.text } }}",

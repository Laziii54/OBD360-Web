{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=GeorgianCarScannerWeb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Obd360Web",
    "Audience": "Obd360WebClient",
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_USER_SECRETS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "N8n": {
    "BaseUrl": "",
    "ScanReportPath": "/webhook/obd360/scan-report",
    "AskPath": "/webhook/obd360/ask",
    "AlertPath": "/webhook/obd360/critical-dtc",
    "WebhookUrl": "",
    "AskWebhookUrl": "",
    "AlertWebhookUrl": "",
    "WebhookToken": "",
    "WebhookTokenHeader": "X-Webhook-Token",
    "TimeoutSeconds": 90,
    "HealthTimeoutSeconds": 3
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "OBD360",
    "EnableSsl": true
  },
  "Reminders": {
    "Enabled": true,
    "CheckIntervalMinutes": 360
  }
}
